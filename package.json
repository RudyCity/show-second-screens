{
  "name": "show-second-screens",
  "version": "0.4.0",
  "description": "Interactive real-time preview and remote control window for target displays with accurate coordinate mapping, moving, and resizing.",
  "homepage": "https://github.com/RudyCity/show-second-screens",
  "repository": {
    "type": "git",
    "url": "https://github.com/RudyCity/show-second-screens.git"
  },
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "start:raw": "electron .",
    "build:injector": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize /target:winexe /out:bin\\injector.exe src\\main\\input\\injector.cs",
    "prebuild:portable": "npm run build:injector",
    "build:portable": "electron-builder --win portable --publish never",
    "prebuild:win": "npm run build:injector",
    "build:win": "electron-builder --win portable --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "dist": "npm run build:portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "keywords": [
    "screen-mirror",
    "second-screen",
    "remote-click",
    "display-preview",
    "pip-window",
    "electron"
  ],
  "author": "RudyCity <hrudy715@gmail.com>",
  "license": "Apache-2.0"
}
